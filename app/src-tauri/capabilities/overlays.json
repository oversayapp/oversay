{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlays",
  "description": "Permissions for plugin overlay windows",
  "windows": [
    "overlay-*"
  ],
  "permissions": [
    "core:default",
    "allow-close-overlay",
    "allow-control-panel-toggle",
    "allow-fit-overlay",
    "allow-keep-overlays-apart",
    "allow-list-session-files",
    "allow-open-overlay",
    "allow-pause-recording",
    "allow-read-config-file",
    "allow-read-deck-sessions",
    "allow-recording-state",
    "allow-session-advance",
    "allow-session-close",
    "allow-session-end",
    "allow-session-next",
    "allow-session-open",
    "allow-session-preview-deck",
    "allow-session-previous",
    "allow-session-toggle-pause",
    "allow-set-hidden-from-capture",
    "allow-set-overlay-layout",
    "allow-set-overlay-settings",
    "allow-set-panel-shortcut",
    "allow-set-window-hidden-from-capture",
    "allow-start-recording",
    "allow-state-get",
    "allow-stop-recording",
    "allow-take-links",
    "allow-trash-session-files",
    "allow-write-config-file",
    "allow-write-deck-sessions",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "log:default"
  ]
}
